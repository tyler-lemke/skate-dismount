extends SceneTree

var checks: int=0
var failures: int=0
func check(condition: bool, message: String) -> void:
	checks+=1
	if not condition:
		failures+=1; printerr("FAIL: ",message)

func _initialize() -> void:
	var rules:=WreckRules.new()
	check(rules.score==0 and rules.multiplier()==1,"clean score starts at x1")
	check(rules.hit_prop(1,600)==600,"first domino has its advertised value")
	check(rules.hit_prop(1,600)==0 and rules.destroyed==1,"duplicate prop cannot inflate score")
	check(rules.hit_prop(2,-200)==0,"invalid value cannot affect score")
	for i in range(2,5): rules.hit_prop(i,600)
	check(rules.combo==4 and rules.multiplier()==2,"four fresh objects unlock x2")
	check(rules.score==3000,"multiplier applies to the triggering wreck")
	rules.tick(3.49)
	check(rules.combo==4,"combo survives inside its real time window")
	rules.tick(.02)
	check(rules.combo==0 and rules.multiplier()==1,"combo expires after 3.5 seconds")
	check(rules.best_combo==4,"expiry preserves longest cascade")
	check(rules.hit_prop(5,1800,true)==1800 and rules.explosions==1,"explosions count and score once")
	rules.hit_prop(5,1800,true)
	check(rules.explosions==1,"same explosion cannot be counted twice")
	check(rules.hit_rider("head:1",2.99)==0,"incidental contact is below rider threshold")
	check(rules.hit_rider("head:1",10)==1764,"head injury pays for eighteen new severity points at its weighted rate")
	check(is_equal_approx(rules.limb_damage.head,18.0) and rules.last_limb=="head","impact persists on its named body region")
	check(rules.hit_rider("head:1",20)==0,"same rider collision bucket cannot double score")
	check(rules.hit_rider("head:2",1000)==8036,"severe injury pays only the remaining head severity")
	check(rules.limb_damage.head==100.0 and rules.limb_payout.head==9800,"head severity and cumulative settlement cap")
	check(rules.hit_rider("head:3",20)==0 and rules.limb_payout.head==9800,"fresh contacts cannot farm a capped body region")
	check(rules.hit_rider("8:shin_l:1",10)==1386,"run-prefixed collision id infers the left shin")
	check(rules.last_limb=="shin_l" and is_equal_approx(rules.limb_damage.shin_l,18.0),"prefixed id affects only its intended limb")
	var clean_score: int = rules.score
	var clean_hits: int = rules.hit_ids.size()
	check(rules.hit_rider("board:1",100)==0,"skateboard cannot make an injury claim")
	check(rules.hit_rider("unknown:1",100)==0,"unknown body region cannot score")
	check(rules.hit_rider("malformed",100)==0,"malformed inferred body region cannot score")
	check(rules.hit_rider("torso:nan",NAN)==0 and rules.hit_rider("torso:inf",INF)==0,"nonfinite impacts cannot corrupt severity or payout")
	check(rules.hit_rider("torso:negative",-100)==0,"negative impact is rejected")
	check(rules.score==clean_score and rules.hit_ids.size()==clean_hits,"rejected contacts leave all claim ledgers untouched")
	check(rules.hit_rider("explicit",10,"torso")==1512,"explicit body region supports callers without encoded ids")
	check(WreckRules.limb_title("fore_r")=="Right forearm" and WreckRules.limb_title("head")=="Head","claim chart uses readable body region titles")
	check(WreckRules.injury_stage(0)=="OK" and WreckRules.injury_stage(.01)=="BRUISED","undamaged and first injury stages")
	check(WreckRules.injury_stage(29.99)=="BRUISED" and WreckRules.injury_stage(30)=="STRAINED","strain boundary")
	check(WreckRules.injury_stage(59.99)=="STRAINED" and WreckRules.injury_stage(60)=="FRACTURED","fracture boundary")
	check(rules.score==rules.property_damage+rules.rider_damage,"score ledger balances")
	rules.reset()
	check(rules.score==0 and rules.destroyed==0 and rules.explosions==0 and rules.hit_ids.is_empty() and rules.prop_ids.is_empty(),"retry resets all scoring ledgers")
	check(rules.limb_damage.size()==11 and rules.limb_payout.size()==11 and rules.last_limb.is_empty(),"retry restores all eleven body regions")
	for limb in rules.limb_damage:
		check(rules.limb_damage[limb]==0.0 and rules.limb_payout[limb]==0,"retry clears injury and settlement for "+limb)
	var split_claim := WreckRules.new()
	var whole_claim := WreckRules.new()
	for i in range(10): split_claim.hit_rider("arm_l:"+str(i),3.01)
	whole_claim.hit_rider("arm_l:whole",30.1)
	check(split_claim.rider_damage==whole_claim.rider_damage,"splitting equal total injury cannot exploit payout rounding")
	check(rules.limb_damage.arm_l==0.0,"body ledgers are independent between rule instances")
	check(WreckRules.POSES.size()==3 and WreckRules.POSES[0].name=="TUCK" and WreckRules.POSES[1].name=="STARFISH" and WreckRules.POSES[2].name=="TORPEDO","three named bail poses are available")
	check(WreckRules.TREATMENT_GOAL>0,"treatment campaign has a positive funding target")
	for i in range(40): rules.hit_prop(i,1)
	check(rules.multiplier()==8,"combo multiplier caps at x8")
	for i in range(3):
		var level:Dictionary=WreckRules.LEVELS[i]
		rules.score=level.bronze-1; check(rules.medal(i)=="ROOKIE","below bronze level "+str(i))
		rules.score=level.bronze; check(rules.medal(i)=="BRONZE","bronze boundary level "+str(i))
		rules.score=level.silver; check(rules.medal(i)=="SILVER","silver boundary level "+str(i))
		rules.score=level.gold; check(rules.medal(i)=="GOLD","gold boundary level "+str(i))
		check(is_equal_approx(WreckRules.surface_y(level,-1),level.steps*level.rise),"runup height level "+str(i))
		check(is_equal_approx(WreckRules.surface_y(level,0),(level.steps-1)*level.rise),"first riser height level "+str(i))
		check(is_zero_approx(WreckRules.surface_y(level,level.steps*level.run)),"bottom of stairs level "+str(i))
		var prior:float=WreckRules.surface_y(level,-1)
		for step in level.steps:
			var height:float=WreckRules.surface_y(level,(step+.5)*level.run)
			check(height<=prior and height>=-.001,"stair surface is monotonic level %d step %d" % [i,step]);prior=height
	check(WreckRules.money(0)=="0","zero score formatting")
	check(WreckRules.money(123)=="123","small score formatting")
	check(WreckRules.money(1234567)=="1,234,567","million score formatting")
	print("RULES: ",checks," checks, ",failures," failures")
	quit(1 if failures else 0)
